# Copy this file to .env and adjust values before running.

# Public URL where users access Backstage in Dokploy
APP_BASE_URL=https://backstage.example.com

# Backend URL (usually same as APP_BASE_URL when served behind one domain)
BACKEND_BASE_URL=https://backstage.example.com

APP_PORT=7007

POSTGRES_DB=backstage
POSTGRES_USER=backstage
POSTGRES_PASSWORD=change-this
